
pipeline {
    agent any

    environment {
        MINIKUBE_PROFILE = 'minikube-new'
        MINIKUBE_HOME = 'C:\\Users\\Omkar Dhenge\\.minikube'
        KUBECONFIG = 'C:\\Users\\Omkar Dhenge\\.kube\\config'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                bat 'mvn clean package -DskipTests'
            }
        }

        stage('Test') {
            steps {
                bat 'mvn test'
            }
            post {
                always {
                    junit(
                        testResults: '**/target/surefire-reports/*.xml',
                        allowEmptyResults: true
                    )
                }
            }
        }

        stage('Docker Build') {
            steps {
                bat '''
                    echo Checking new Minikube cluster...
                    minikube status -p minikube-new

                    echo Configuring Docker for minikube-new...
                    minikube -p minikube-new docker-env --shell cmd > minikube-new-env.bat
                    call minikube-new-env.bat

                    echo Checking Docker...
                    docker info

                    echo Building Order Service image...
                    docker build -t order-service:latest .

                    echo Checking application images...
                    docker images
                '''
            }
        }

        stage('Check Kubernetes') {
            steps {
                bat '''
                    echo Checking Kubernetes context...
                    kubectl --context=minikube-new config current-context

                    echo Checking Kubernetes connection...
                    kubectl --context=minikube-new cluster-info

                    echo Checking nodes...
                    kubectl --context=minikube-new get nodes
                '''
            }
        }

        stage('Deploy Eureka Server') {
            steps {
                bat '''
                    echo Creating Eureka Server Deployment...

                    kubectl --context=minikube-new create deployment eureka-server --image=eureka-server:latest --replicas=1 --dry-run=client -o yaml > eureka-deployment.yaml

                    kubectl --context=minikube-new patch deployment eureka-server --type=strategic -p "{\\"spec\\":{\\"template\\":{\\"spec\\":{\\"containers\\":[{\\"name\\":\\"eureka-server\\",\\"imagePullPolicy\\":\\"Never\\",\\"ports\\":[{\\"containerPort\\":8761}],\\"env\\":[{\\"name\\":\\"SERVER_PORT\\",\\"value\\":\\"8761\\"}]}]}}}}"

                    echo Creating Eureka Service...

                    kubectl --context=minikube-new expose deployment eureka-server --name=eureka-service --port=8761 --target-port=8761 --type=ClusterIP

                    echo Waiting for Eureka Server...
                    kubectl --context=minikube-new rollout status deployment/eureka-server --timeout=180s
                '''
            }
        }

        stage('Deploy Review Service') {
            steps {
                bat '''
                    echo Creating Review Service Deployment...

                    kubectl --context=minikube-new create deployment review-service --image=review-service:latest --replicas=1 --dry-run=client -o yaml > review-deployment.yaml

                    kubectl --context=minikube-new patch deployment review-service --type=strategic -p "{\\"spec\\":{\\"template\\":{\\"spec\\":{\\"containers\\":[{\\"name\\":\\"review-service\\",\\"imagePullPolicy\\":\\"Never\\",\\"ports\\":[{\\"containerPort\\":8082}],\\"env\\":[{\\"name\\":\\"SPRING_PROFILES_ACTIVE\\",\\"value\\":\\"dev\\"},{\\"name\\":\\"SERVER_PORT\\",\\"value\\":\\"8082\\"}]}]}}}}"

                    echo Creating Review Service Kubernetes Service...

                    kubectl --context=minikube-new expose deployment review-service --name=review-service --port=8082 --target-port=8082 --type=ClusterIP

                    echo Waiting for Review Service...
                    kubectl --context=minikube-new rollout status deployment/review-service --timeout=180s
                '''
            }
        }

        stage('Deploy Order Service') {
            steps {
                bat '''
                    echo Applying Order Service Kubernetes Service...
                    kubectl --context=minikube-new apply -f src/main/resources/order-service.yaml

                    echo Applying Order Service Deployment...
                    kubectl --context=minikube-new apply -f src/main/resources/order-deployment.yaml

                    echo Waiting for Order Service...
                    kubectl --context=minikube-new rollout status deployment/order-service --timeout=180s
                '''
            }
        }

        stage('Enable Autoscaling') {
            steps {
                bat '''
                    echo Enabling Metrics Server...
                    minikube addons enable metrics-server -p minikube-new

                    echo Configuring Order Service HPA...
                    kubectl --context=minikube-new autoscale deployment order-service --cpu-percent=50 --min=1 --max=3 --dry-run=client -o yaml | kubectl --context=minikube-new apply -f -
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                bat '''
                    echo Checking all deployments...
                    kubectl --context=minikube-new get deployments

                    echo Checking all pods...
                    kubectl --context=minikube-new get pods -o wide

                    echo Checking Kubernetes services...
                    kubectl --context=minikube-new get services

                    echo Checking HPA...
                    kubectl --context=minikube-new get hpa
                '''
            }
        }
    }

    post {
        success {
            echo 'Eureka Server, Review Service and Order Service deployment completed successfully!'
        }

        failure {
            echo 'Pipeline failed. Check the Jenkins console output and identify the failed stage.'
        }
    }
}

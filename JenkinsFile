pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                bat 'mvn clean package -DskipTests'
            }
        }

        stage('Test') {
            steps {
                bat 'mvn test'
            }

            post {
                always {
                    junit(
                        testResults: '**/target/surefire-reports/*.xml',
                        allowEmptyResults: true
                    )
                }
            }
        }

        stage('Docker Build') {
            steps {
                bat '''
                    minikube start
                    echo Checking Minikube...
                    where minikube
                    minikube status

                    set "MINIKUBE_HOME=C:\\Users\\Omkar Dhenge\\.minikube"

                    echo Configuring Minikube Docker environment...
                    minikube docker-env --shell cmd > minikube-env.bat

                    call minikube-env.bat

                    echo Checking Docker...
                    docker info

                    echo Building Order Service image...
                    docker build -t order-service:latest .
                '''
            }
        }

        stage('Check Kubernetes') {
            steps {
                bat '''
                    set "KUBECONFIG=C:\\Users\\Omkar Dhenge\\.kube\\config"

                    echo Checking Kubernetes context...
                    kubectl config current-context

                    echo Checking Kubernetes connection...
                    kubectl cluster-info
                '''
            }
        }

        stage('Deploy') {
            steps {
                bat '''
                    set "KUBECONFIG=C:\\Users\\Omkar Dhenge\\.kube\\config"

                    echo Applying Kubernetes Service...
                    kubectl apply -f src/main/resources/order-service.yaml

                    echo Applying Kubernetes Deployment...
                    kubectl apply -f src/main/resources/order-deployment.yaml

                    echo Waiting for deployment...
                    kubectl rollout status deployment/order-service --timeout=180s

                    echo Checking pods...
                    kubectl get pods
                    start "Order Service" cmd /c kubectl port-forward svc/order-service 8081:8081
                    start "Review Service" cmd /c kubectl port-forward svc/review-service 8082:8082
                    start "Eureka Server" cmd /c kubectl port-forward svc/eureka-service 8761:8761
                '''
            }
        }
    }

    post {
        success {
            echo 'Order Service deployed successfully!'
        }

        failure {
            echo 'Pipeline failed. Check Jenkins console output.'
        }
    }
}
